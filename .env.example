# Public site URL (required in production for correct canonicals, sitemap, Open Graph)
NNEXT_PUBLIC_SITE_URL=https://digitalaccessready.com

# SEO / indexing (production)
# Allow search indexing on non-Vercel production hosts (Vercel production indexes automatically)
# SITE_INDEXABLE=1
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# INDEXNOW_KEY=
# INDEXNOW_KEY_LOCATION=

# SEO blog (server-only — public editorial content only; optional for build)
MONGODB_URI=
MONGODB_DB_NAME=
# Optional: comma-separated HTTPS hostnames allowed for blog thumbnails (next/image)
# BLOG_IMAGE_HOSTS=cdn.example.com
# BLOG_REVALIDATE_SECONDS=900

# Server-only OpenAI (optional — local preflight works without it)
OPENAI_API_KEY=

# Vision model (server-only)
OPENAI_VISION_MODEL=

# Image detail: auto | low | high
OPENAI_IMAGE_DETAIL=

# Video transcription models (server-only)
OPENAI_CAPTION_MODEL=whisper-1
OPENAI_DIARIZATION_MODEL=gpt-4o-transcribe-diarize

# Video product limits
VIDEO_MAX_FILE_SIZE_MB=24
VIDEO_MAX_DURATION_SECONDS=600



# Secured orphan media cleanup (server-only)
CRON_SECRET=
MEDIA_CLEANUP_MAX_AGE_MS=7200000

# Local dev: allow in-memory video buffer when Blob is unset (server-only)
VIDEO_DEV_DIRECT_UPLOAD=1

# Optional request timeout in ms (minimum 15000, max 180000)
OPENAI_REQUEST_TIMEOUT_MS=

# Optional text model for non-remediation server features (server-only).
# Shared AI remediation uses OPENAI_REMEDIATION_MODEL only — not OPENAI_TEXT_MODEL.
OPENAI_TEXT_MODEL=

# Shared AI Remediation Assistant (server-only; explicit POST only — no UI in AI-R1)
# Required for remediation when OPENAI_API_KEY is set — use a model that supports strict json_schema (e.g. gpt-4.1-mini)
OPENAI_REMEDIATION_MODEL=gpt-4.1-mini
OPENAI_REMEDIATION_TIMEOUT_MS=
AI_REMEDIATION_ENABLED=1
# Optional caps (defaults in src/lib/openai/config.ts)
# MAX_AI_REMEDIATIONS_PER_SESSION=
# MAX_AI_REMEDIATIONS_PER_SCAN=

# Public marketing: show primary CTA to /website-accessibility-scanner (1 or true)
# WEBSITE_SCANNER_PUBLIC_ENABLED=1

# Website scanner (server-only)
# local = Playwright in Next/Node process; remote = call scanner Docker service (Hostinger worker)
# On Vercel production use remote after tunnel — see SCANNER_WORKER_DEPLOYMENT.md
SCANNER_RUNTIME=local
# e.g. https://scanner.digitalaccessready.com (Cloudflare → 127.0.0.1:8787 on VPS)
SCANNER_SERVICE_URL=
# Same secret as scanner-worker/.env on Hostinger (never NEXT_PUBLIC_*)
SCANNER_SERVICE_TOKEN=
SCANNER_USER_AGENT=
# Worker + local runtime: SCANNER_MAX_CONCURRENT=1 (default)

# Visual Issue Locator — HMAC token signing (required in production to enable)
VISUAL_LOCATOR_SIGNING_SECRET=

# Vitest Playwright fixtures only — never enable in production
# WEBSITE_SCANNER_TEST_ALLOW_LOOPBACK=1
