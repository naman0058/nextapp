# Copy to .env on the Hostinger VPS (never commit .env).
# Generate token: openssl rand -hex 32

SCANNER_SERVICE_TOKEN=

# Worker listen port (host publish is 127.0.0.1:8787:8787 in docker-compose.yml)
PORT=8787

# Production default — one scan at a time (max 2 in code)
SCANNER_MAX_CONCURRENT=1

# Optional echoes of app-side limits (documented on Vercel; worker enforces concurrency via SCANNER_MAX_CONCURRENT)
# SCAN_CONCURRENCY=1
